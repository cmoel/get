#!/bin/bash
# Self-check for `get`. No network: a fake `curl` on PATH records its args.
set -u
cd "$(dirname "$0")"
FAKE=$(mktemp -d)
printf '#!/bin/bash\nprintf "%%s\\n" "$@" > "$CURL_ARGS"\n' > "$FAKE/curl"
chmod +x "$FAKE/curl"
export PATH="$FAKE:$PATH" CURL_ARGS="$FAKE/args"

fail=0
pass() { echo "ok   $1"; }
flunk() { echo "FAIL $1"; fail=1; }

rejects() { # rejects "<desc>" args...  -> nonzero exit, curl never called, change-request hint on stderr
  local desc=$1; shift
  : > "$CURL_ARGS"
  if ./get "$@" >/dev/null 2>"$FAKE/err" || [ -s "$CURL_ARGS" ]; then flunk "$desc"; return; fi
  grep -q "propose" "$FAKE/err" || { flunk "$desc (no change-request hint)"; return; }
  pass "$desc"
}
accepts() { # accepts "<desc>" args...  -> curl called, args in $CURL_ARGS
  local desc=$1; shift
  : > "$CURL_ARGS"
  if ./get "$@" >/dev/null 2>"$FAKE/err" && [ -s "$CURL_ARGS" ]; then pass "$desc"; else flunk "$desc: $(cat "$FAKE/err")"; fi
}
curl_got() { grep -qxF -- "$1" "$CURL_ARGS"; }

U=https://example.com/

accepts "https url" $U
  curl_got "$U" || flunk "url not passed to curl"
  curl_got "-L" || flunk "redirects must be followed"
  [ "$(head -1 "$CURL_ARGS")" = "-q" ] || flunk "-q must be curl's first arg"
  curl_got "-sS" || flunk "curl must run silent but show errors"
accepts "http url"  http://example.com/

rejects "no url"
rejects "-X POST"     -X POST $U
rejects "-d body"     -d '{}' $U
rejects "-XPOST"      -XPOST $U
rejects "--foo"       --foo $U
rejects "-- separator" -- $U
rejects "file:// url" file:///etc/passwd
rejects "bare host"   example.com

for h in -h --help; do
  : > "$CURL_ARGS"
  if ./get $h 2>/dev/null | grep -q '^usage:' && [ ! -s "$CURL_ARGS" ]; then pass "$h prints get's usage"; else flunk "$h prints get's usage"; fi
done

# no-curl.sh: PreToolUse hook. Denies any Bash command mentioning curl.
hook() { printf '{"tool_input":{"command":%s}}' "$(printf '%s' "$1" | jq -Rs .)" | ./no-curl.sh; }
hook 'curl https://x'          | grep -q '"deny"' && pass "hook denies curl"          || flunk "hook denies curl"
hook '/usr/bin/curl -X POST x' | grep -q '"deny"' && pass "hook denies /usr/bin/curl" || flunk "hook denies /usr/bin/curl"
hook 'ls | xargs curl'         | grep -q '"deny"' && pass "hook denies piped curl"    || flunk "hook denies piped curl"
hook 'curl https://x'          | grep -q 'get '   && pass "hook message names get"   || flunk "hook message names get"
[ -z "$(hook 'get https://x')" ]       && pass "hook allows get"    || flunk "hook allows get"
[ -z "$(hook 'git commit -m curly')" ] && pass "hook ignores curly" || flunk "hook ignores curly"

[ $fail = 0 ] && echo "all passed" || { echo "FAILED"; exit 1; }
