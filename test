#!/bin/bash
# Self-check for `get`. No network: a fake `curl` on PATH records its args.
set -u
cd "$(dirname "$0")"
FAKE=$(mktemp -d)
printf '#!/bin/bash\nprintf "%%s\\n" "$@" > "$CURL_ARGS"\n' > "$FAKE/curl"
chmod +x "$FAKE/curl"
export PATH="$FAKE:$PATH" CURL_ARGS="$FAKE/args"

fail=0
pass() { echo "ok   ${1//$'\n'/\\n}"; }
flunk() { echo "FAIL ${1//$'\n'/\\n}"; fail=1; }

rejects() { # rejects "<desc>" args...  -> nonzero exit, curl never called, change-request hint on stderr
  local desc=$1; shift
  : > "$CURL_ARGS"
  if ./get "$@" >/dev/null 2>"$FAKE/err" || [ -s "$CURL_ARGS" ]; then flunk "$desc"; return; fi
  grep -q "propose" "$FAKE/err" || { flunk "$desc (no change-request hint)"; return; }
  pass "$desc"
}
accepts() { # accepts "<desc>" args...  -> curl called, args in $CURL_ARGS
  local desc=$1; shift
  : > "$CURL_ARGS"
  if ./get "$@" >/dev/null 2>"$FAKE/err" && [ -s "$CURL_ARGS" ]; then pass "$desc"; else flunk "$desc: $(cat "$FAKE/err")"; fi
}
curl_got() { grep -qxF -- "$1" "$CURL_ARGS"; }

U=https://example.com/

accepts "https url" $U
  curl_got "$U" || flunk "url not passed to curl"
  curl_got "-L" || flunk "redirects must be followed"
  [ "$(head -1 "$CURL_ARGS")" = "-q" ] || flunk "-q must be curl's first arg"
  curl_got "-sS" || flunk "curl must run silent but show errors"
  curl_got "-g"  || flunk "url globbing must be off, or [1-1000] is a thousand requests"
accepts "http url"  http://example.com/

rejects "no url"
rejects "-X POST"     -X POST $U
rejects "-d body"     -d '{}' $U
rejects "-XPOST"      -XPOST $U
rejects "--foo"       --foo $U
rejects "-- separator" -- $U
rejects "file:// url" file:///etc/passwd
rejects "bare host"   example.com

accepts "html by default" $U
  curl_got '-H' && curl_got 'Accept: text/html' || flunk "default Accept: text/html not sent"
accepts "-a application/json" -a application/json $U
  curl_got 'Accept: application/json' || flunk "-a value not sent"
  curl_got 'Accept: text/html' && flunk "-a must replace the default, not add to it"
accepts "--accept text/html" --accept text/html $U
accepts "-a text/markdown" -a text/markdown $U
  curl_got 'Accept: text/markdown' || flunk "-a text/markdown not sent"
accepts "-a text/plain" -a text/plain $U
  curl_got 'Accept: text/plain' || flunk "-a text/plain not sent"
accepts "-a application/xml" -a application/xml $U
  curl_got 'Accept: application/xml' || flunk "-a application/xml not sent"
rejects "-a json shorthand" -a json $U
rejects "-a */* wildcard"   -a '*/*' $U
rejects "-a application/javascript" -a application/javascript $U
rejects "-a text/css"       -a text/css $U
rejects "-a swallows the url" -a $U
rejects "-a with nothing after" $U -a
rejects "-aapplication/json attached" -aapplication/json $U
rejects "-H header"  -H 'Accept: application/json' $U

for h in -h --help; do
  : > "$CURL_ARGS"
  if ./get $h 2>/dev/null | grep -q '^usage:' && [ ! -s "$CURL_ARGS" ]; then pass "$h prints get's usage"; else flunk "$h prints get's usage"; fi
done

./get -X $U 2>&1 | grep -qF "$PWD/get" && pass "refusal names get's real path" || flunk "refusal names get's real path"

# no-curl.sh: PreToolUse hook. Denies any Bash command that runs curl.
hook() { printf '{"tool_input":{"command":%s}}' "$(printf '%s' "$1" | jq -Rs .)" | ./no-curl.sh; }
denies() { hook "$1" | grep -q '"deny"' && pass "hook denies: $1" || flunk "hook denies: $1"; }
allows() { [ -z "$(hook "$1")" ]       && pass "hook allows: $1" || flunk "hook allows: $1"; }
denies 'curl https://x'
denies '/usr/bin/curl -X POST x'
denies 'ls | xargs curl'
denies 'cd /tmp && curl x'
denies 'echo $(curl x)'
denies 'curl'
denies 'curl x; ls'
denies $'ls\ncurl x'
denies 'bash -c "curl x"'
denies "sh -c 'curl x'"
denies 'curl>/dev/null x'
denies '\curl https://x'
denies "cu''rl https://x"
denies 'c""url https://x'
allows 'get https://x'
allows 'git commit -m curly'
allows 'cat no-curl.sh'
allows 'cat curl.sh'
allows 'ls'
hook 'curl https://x' | grep -q 'get '        && pass "hook message names get"           || flunk "hook message names get"
hook 'curl https://x' | grep -qF "$PWD/get"   && pass "hook message names get's real path" || flunk "hook message names get's real path"

# Without jq, or with input it can't read, the hook can't tell what it's looking at. Fail closed: exit 2.
mkdir "$FAKE/nojq"; for t in bash grep dirname readlink; do ln -s "$(command -v "$t")" "$FAKE/nojq/$t"; done
PATH=$FAKE/nojq ./no-curl.sh </dev/null >/dev/null 2>"$FAKE/err"
[ $? = 2 ] && grep -q jq "$FAKE/err" && pass "hook fails closed without jq" || flunk "hook fails closed without jq"
printf 'not json' | ./no-curl.sh >/dev/null 2>"$FAKE/err"
[ $? = 2 ] && [ -s "$FAKE/err" ] && pass "hook fails closed on unreadable input" || flunk "hook fails closed on unreadable input"

[ $fail = 0 ] && echo "all passed" || { echo "FAILED"; exit 1; }
