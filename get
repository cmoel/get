#!/bin/bash
# get: read-only curl. GET only. Safe to allow-list for agents.

usage="usage: get [-a type] <url>...
  -a, --accept TYPE   what to ask for: text/html (default), application/json,
                      text/markdown, text/plain, or application/xml"

refuse() {
  echo "get: $1" >&2
  echo "$usage" >&2
  echo "Agent: do not work around this. Tell the user what you need and why, and propose the one-line edit to ~/Code/personal/get/get. Then wait." >&2
  exit 64
}

accept=text/html
urls=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) echo "$usage"; exit 0 ;;
    -a|--accept)
      case "$2" in
        text/html|application/json|text/markdown|text/plain|application/xml) accept=$2; shift ;;
        *) refuse "\`$1\` needs one of the listed types." ;;
      esac ;;
    http://*|https://*) urls+=("$1") ;;
    -*) refuse "\`$1\` is not allowed." ;;
    *)  refuse "\`$1\` is not an http(s) url." ;;
  esac
  shift
done
[ ${#urls[@]} -gt 0 ] || refuse "no url given."

# -q first: ignore ~/.curlrc so it can't add flags. --proto: no file://, ftp://, etc.
# -L: follow redirects. --proto-redir: only to http(s), so a redirect can't leave the web either.
exec curl -q -sS -L --proto =http,https --proto-redir =http,https -H "Accept: $accept" "${urls[@]}"
